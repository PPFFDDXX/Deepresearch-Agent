# Configuration checks and offline demos require no credentials.
# Real research needs DR_API_KEY; Web research also needs DR_TAVILY_API_KEY.
DR_MODEL_NAME=glm-4.5-flash
DR_API_KEY=
DR_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DR_LLM_TIMEOUT_SECONDS=180
DR_PLANNER_MAX_TASKS=5
DR_PLANNER_MAX_ATTEMPTS=2
DR_MAX_RETRIES=2
DR_TOOL_TIMEOUT_SECONDS=20
DR_SEARCH_TOP_K=5
# Search key is separate from the GLM model key.
DR_TAVILY_API_KEY=
DR_SEARCH_MAX_ATTEMPTS=2
DR_RESEARCHER_MAX_ATTEMPTS=2
DR_RESEARCHER_MAX_EVIDENCE=10
# Research rounds, evaluation-call retries and tasks per refinement are separate budgets.
DR_CRITIC_MAX_ATTEMPTS=2
DR_CRITIC_MAX_TASKS=3
DR_CRITIC_MIN_SCORE=0.7
DR_WRITER_MAX_ATTEMPTS=2
# BGE-M3 via SiliconFlow. Set provider=hashing for offline retrieval.
DR_EMBEDDING_PROVIDER=api
DR_EMBEDDING_DIMENSIONS=1024
DR_EMBEDDING_MODEL=BAAI/bge-m3
DR_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
DR_EMBEDDING_API_KEY=
DR_EMBEDDING_BATCH_SIZE=16
DR_EMBEDDING_MAX_ATTEMPTS=2
DR_EMBEDDING_TIMEOUT_SECONDS=60
# BGE-M3 automatically enforces 1024; optional for other models.
DR_EMBEDDING_EXPECTED_DIMENSIONS=
DR_RAG_CHUNK_SIZE=600
DR_RAG_CHUNK_OVERLAP=80
DR_RAG_TOP_K=4
DR_RAG_MIN_SCORE=0.05
DR_RAG_MAX_FILE_MB=10
DR_RAG_MAX_FILES=100
DR_WRITER_TIMEOUT_SECONDS=180
# Local metadata-only observability. INFO prints trace events to stderr.
DR_LOG_LEVEL=WARNING
DR_TRACE_FILE=
